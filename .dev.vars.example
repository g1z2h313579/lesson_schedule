# 后端本地开发用环境变量：复制为 .dev.vars 后使用（.dev.vars 不提交到 git）
# 这里的值会覆盖 wrangler.jsonc 中 vars 的同名变量

APP_ENV=development

# 跳过 LINE 登录校验，使用模拟用户（仅本地开发）
AUTH_MOCK=true

# LINE MINI App 渠道的 Channel ID（AUTH_MOCK=false 时需要填写）
LINE_CHANNEL_ID=

# LINE 官方账号 Messaging API 的 Channel access token（推送提醒消息用）
LINE_CHANNEL_ACCESS_TOKEN=
