{
  // 前端（React）
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["web/src", "shared"],
  // 引用后端项目，以便前端安全地导入后端路由类型
  "references": [{ "path": "./tsconfig.server.json" }]
}
