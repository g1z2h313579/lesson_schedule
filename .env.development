# 前端本地开发用环境变量（只在 `pnpm dev` 时生效）
# 如需覆盖，请新建 .env.development.local（不提交到 git）

# 使用 LIFF Mock：不需要在 LINE 中打开也能登录
# 用手机在 LINE 里真机调试时，在 .env.development.local 中改为 false
VITE_LIFF_MOCK=true

# 默认的模拟用户（配合后端 AUTH_MOCK=true 使用）
# 页面顶部的下拉框可以切换模拟用户（老师、学生、管理员、未注册的新用户），见 web/src/lib/mock-user.ts
VITE_MOCK_USER_ID=U_mock_teacher
