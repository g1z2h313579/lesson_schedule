{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker 名称：需要与 Workers Builds 中连接的 Worker 名称一致
  "name": "lesson-schedule",
  // 后端入口（Hono + 定时任务）
  "main": "./server/index.ts",
  "compatibility_date": "2026-11-01",
  "upload_source_maps": true,
  // 使用 https://lesson-schedule.<账号子域名>.workers.dev 访问（LINE MINI App 的 Endpoint URL 填这个地址）
  "workers_dev": true,
  // 不需要每个版本单独的预览地址（本项目没有测试环境）
  "preview_urls": false,

  // 静态资源（前端构建产物），目录由 Cloudflare Vite 插件自动设置
  "assets": {
    // 前端是单页应用：找不到的路径一律返回 index.html，交给 React Router 处理
    "not_found_handling": "single-page-application",
    // /api/* 的请求先交给 Worker（Hono）处理
    "run_worker_first": ["/api/*"]
  },

  // D1 数据库
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lesson-schedule",
      // 线上数据库的 ID（由 `pnpm wrangler d1 create lesson-schedule --location apac` 创建，不是密钥）
      // 本地开发使用 .wrangler/state 中的本地数据库，不会连到线上
      "database_id": "5b26ab28-b1d8-4009-aa0f-5e6d4fbf5d60",
      // 迁移文件由 drizzle-kit 生成
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // R2 存储桶：留言图片（不公开，只能通过 /api/images/:id 在检查权限后读取）
  // 本地开发和测试时使用模拟的 R2（.wrangler/state），不会连到线上
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "lesson-schedule-images"
    }
  ],

  // 实时通知中心（Durable Object，每个用户一个实例），处理逻辑在 server/durable-objects/notification-hub.ts
  // 本地开发和测试时在本地运行，不会连到线上
  "durable_objects": {
    "bindings": [{ "name": "NOTIFICATION_HUB", "class_name": "NotificationHub" }]
  },
  // Durable Object 的类变更记录（只能追加，不能修改已部署的记录）
  // 免费计划只能使用 SQLite 存储的类，所以用 new_sqlite_classes
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NotificationHub"] }],

  // 普通环境变量（非密钥）。本地开发时会被 .dev.vars 中的同名变量覆盖
  "vars": {
    // 运行环境：production / development / test
    "APP_ENV": "production",
    // 是否跳过 LINE 登录校验、使用模拟用户（只允许在本地开发时为 "true"）
    "AUTH_MOCK": "false",
    // LINE MINI App 渠道的 Channel ID（用于校验 ID token，不是密钥）
    // MINI App 分 Developing / Review / Published 三个版本，Channel ID 依次为 2012328071 / 2012328072 / 2012328073
    // 必须与 .env 中 VITE_LIFF_ID 的前半部分一致（线上使用 Published 版本）
    "LINE_CHANNEL_ID": "2012328073"
  },
  // 密钥（用 `pnpm wrangler secret put <名称>` 设置，不写在这里）：
  //   LINE_CHANNEL_ACCESS_TOKEN：LINE 官方账号 Messaging API 的令牌，用于推送提醒

  // 定时任务（UTC 时间），处理逻辑在 server/jobs/index.ts
  // "0 15 * * *" = 日本时间每天 0:00：按每周课程补排课程（每月最后一天会排好下个月的课）
  "triggers": { "crons": ["0 15 * * *"] },

  // 开启 Workers Logs，方便在控制台查看日志
  "observability": { "enabled": true }
}
